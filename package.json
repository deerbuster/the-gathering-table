    "@angular/platform-browser": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "dompurify": "^3.2.7",
    "firebase": "^11.10.0",
    "marked": "^16.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
